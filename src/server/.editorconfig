# To learn more about .editorconfig see https://aka.ms/editorconfigdocs

# All files
[*]
indent_style = space

# Xml files
[*.xml]
indent_size = 2

[*.cs]
insert_final_newline = false
csharp_style_namespace_declarations = file_scoped:warning
# Logging runs a few times per synchronization, so LoggerMessage delegates wouldn't make a difference
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA1873.severity = none
# Factory methods on generic types, e.g. ThirdPartyResponse<T>.Success, are intended
dotnet_diagnostic.CA1000.severity = none

[{*.Tests,*.TestUtilities}/**.cs]
# Test names separate their parts with underscores
dotnet_diagnostic.CA1707.severity = none
# Arrays in test data are created once per test
dotnet_diagnostic.CA1861.severity = none
# The tests run in seconds, so passing TestContext.Current.CancellationToken everywhere isn't worth the noise
dotnet_diagnostic.xUnit1051.severity = none

[*.csproj]
indent_size = 2

[*/Migrations/*]
generated_code = true
