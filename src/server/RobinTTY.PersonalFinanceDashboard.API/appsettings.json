{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "AppConfiguration": {
    "DatabaseConfiguration": {
      "ConnectionString": "Data Source=PersonalFinanceDashboard.db"
    }
  }
}
